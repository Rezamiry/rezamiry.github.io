---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const date = new Intl.DateTimeFormat('en-CA', { dateStyle: 'long', timeZone: 'UTC' }).format(d.date);
---
<Base title={d.title} description={d.description} type="article" publishedTime={d.date}>
  <article class="container prose page-head" style="padding-bottom:56px">
    <a class="back" href="/blog/">← All posts</a>
    <p class="eyebrow"><time datetime={d.date.toISOString()}>{date}</time></p>
    <h1>{d.title}</h1>
    <Content />
    {d.tags.length > 0 && <ul class="chips">{d.tags.map((t) => <li class="chip">{t}</li>)}</ul>}
  </article>
</Base>
